{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // The Deploy button creates both resources. From a terminal, `wrangler deploy` creates the KV
  // namespace. Create the database with `wrangler d1 create mailroom --binding DB` before the
  // first `npm run deploy`, because that script applies migrations/ before it deploys.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "d1_databases": [{ "binding": "DB", "database_name": "mailroom" }],

  // Workers AI converts PDF and Office attachments to text. The binding needs no resource. Workers AI
  // has no local version, so `wrangler dev` sends these conversions to the Cloudflare account.
  "ai": { "binding": "AI" },

  // Static files that Cloudflare serves before the Worker runs: the IBM Plex fonts of the pages.
  "assets": { "directory": "./public" },

  "vars": {
    "APP_NAME": "Mailroom"
  }
  // Secret (set at deploy time, or `wrangler secret put ADMIN_PASSWORD`): ADMIN_PASSWORD
}
